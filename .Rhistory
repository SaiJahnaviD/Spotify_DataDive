install.packages(logit)
install.packages(logistic)
# List of packages required for logistic regression workflows
required_pkgs <- c(
"blorr",      # Tools for building and validating logistic models [1]
"glmnet",     # Regularized (lasso/ridge/elastic-net) GLMs
"mlogit",     # Multinomial logit models
"logistf",    # Firth’s bias‐reduced logistic regression
"broom",      # Tidying model outputs
"tidymodels"  # A unified modeling framework (includes parsnip, recipes, workflows)
)
# Install any that aren’t already installed
install.packages(setdiff(required_pkgs, rownames(installed.packages())))
# Load all packages into the session
lapply(required_pkgs, library, character.only = TRUE)
